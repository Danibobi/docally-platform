{
  "name": "docally-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production monorepo for DocAlly: extension, web platform, API, and shared accessibility intelligence contracts.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @docally/web",
    "dev:web": "npm run dev --workspace @docally/web",
    "dev:api": "npm run dev --workspace @docally/api",
    "dev:extension": "npm run dev --workspace @docally/extension",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
